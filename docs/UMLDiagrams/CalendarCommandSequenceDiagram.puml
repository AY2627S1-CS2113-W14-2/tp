@startuml
skinparam sequenceMessageAlign center
hide footbox

actor User

participant ":Ui" as UI

participant ":Parser" as Parser
participant ":BookingList" as Bookings

User -> UI: processCommand("calendar")
activate UI

UI -> Parser: parseCommand(userInput)
activate Parser
Parser --> UI: "calendar"
deactivate Parser

UI -> Parser: parseCalendar(userInput)
activate Parser
Parser --> UI
deactivate Parser

create participant ":CalendarCommand" as Calendar
UI -> Calendar: new CalendarCommand()

UI -> Calendar: execute(bookingList, "today")
activate Calendar

Calendar -> Calendar: execute(bookingList, LocalDate.now())
activate Calendar

Calendar -> Bookings: findByDate(date)
activate Bookings
Bookings --> Calendar: dayBookings
deactivate Bookings

alt dayBookings is empty
    Calendar --> User: "No bookings on dd/MM/yyyy."
else bookings found
    Calendar --> User: numbered bookings with start time, earliest first
end

deactivate Calendar

Calendar --> UI
deactivate Calendar

deactivate UI
@enduml