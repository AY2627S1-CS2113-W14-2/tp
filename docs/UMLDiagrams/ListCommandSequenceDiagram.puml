@startuml
skinparam sequenceMessageAlign center
hide footbox

actor User

participant ":Ui" as UI

participant ":Parser" as Parser

User -> UI: processCommand("list r/exams s/alpha")
activate UI

UI -> Parser: parseCommand(userInput)
activate Parser
Parser --> UI: "list"
deactivate Parser

UI -> Parser: parseViewList(userInput)
activate Parser
Parser --> UI: ListOptions("exams", ALPHABETIC)
deactivate Parser

UI --> User: the listing heading
note right of UI: Print the listing heading

create participant ":ListCommand" as List
UI -> List: new ListCommand()
participant "lastShownList:ArrayList<Booking>" as Shown
participant ":BookingList" as Bookings

UI -> List: execute(bookingList, "exams", ALPHABETIC)
activate List

List -> Bookings: size()
activate Bookings
Bookings --> List: listSize
deactivate Bookings

List -> Shown: clear()
note right of Shown: Clear lastShownList

loop i = 0 to listSize - 1
    List -> Bookings: get(i)
    activate Bookings
    Bookings --> List: booking
    deactivate Bookings

    opt booking.getReason().equals("exam")
       List -> Shown: addLast(booking)
       note right of Shown: Add booking to lastShownList
    end
end

List -> List: sortLastShownList(ALPHABETIC)
activate List
deactivate List

List -> List: printLastShownList()
activate List
List --> User: numbered bookings in alphabetical order
note right of List
Print numbered bookings
in alphabetical order
end note
deactivate List

deactivate List

deactivate UI
@enduml
