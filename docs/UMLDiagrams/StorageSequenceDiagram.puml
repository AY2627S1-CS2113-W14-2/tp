@startuml
scale 2
skinparam sequenceMessageAlign center
hide footbox

participant ":Storage" as Storage
participant ":BookingList" as Bookings
participant ":Booking" as Booking

group Load saved bookings
    [-> Storage: loadBookings()
    activate Storage

    alt data file does not exist
        Storage -> Storage: createEmptyDataFile()
        Storage -->[: empty booking list
    else data file exists
        Storage -> Storage: read saved lines

        loop for each nonblank line
            Storage -> Storage: parseBooking(line, lineNumber)

            alt old five-part line
                Storage -> Storage: attendeeCount = null
            else new six-part line
                Storage -> Storage: parse and validate attendee count
            end

            Storage -> Booking: new Booking(...)
            activate Booking
            Booking --> Storage: booking
            deactivate Booking

            Storage -> Bookings: add(booking)
            activate Bookings
            Bookings --> Storage
            deactivate Bookings
        end

        Storage -->[: booking list
    end

    deactivate Storage
end

group Save current bookings
    [-> Storage: saveBookings(bookings)
    activate Storage

    loop for each booking
        Storage -> Bookings: get(index)
        activate Bookings
        Bookings --> Storage: booking
        deactivate Bookings

        Storage -> Storage: bookingToLine(booking)
        activate Storage
        Storage -> Booking: get booking details
        activate Booking
        Booking --> Storage: reason, name, venue,\ntiming and attendee count
        deactivate Booking

        deactivate Storage
    end

    Storage -> Storage: write lines to bookings.txt
    Storage -->[
    deactivate Storage
end

@enduml
