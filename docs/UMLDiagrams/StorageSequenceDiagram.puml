@startuml
scale 2
skinparam sequenceMessageAlign center
hide footbox

actor User
participant ":Storage" as Storage
participant ":BookingList" as Bookings
participant ":Booking" as Booking


group Load saved username
    User -> Storage: loadUserName()
    activate Storage

    Storage --> User: username or null
    deactivate Storage

    alt no username is saved
        User -> Storage: saveUserName(userName)
        activate Storage
        Storage --> User
        deactivate Storage
    end
end

group Load saved bookings
    User -> Storage: loadBookings()
    activate Storage

    alt data file does not exist
        Storage -> Storage: createEmptyDataFile()
        Storage --> User: empty booking list
    else data file exists
        Storage -> Storage: read saved lines

        loop for each nonblank line
            Storage -> Storage: parseBooking(line, lineNumber)

            alt old five-part line
                note right of Storage
                    Set attendee count to null.
                end note
            else new six-part line
                note right of Storage
                    Parse and validate
                    the attendee count.
                end note
            end

            Storage -> Booking: new Booking(...)
            activate Booking
            Booking --> Storage: booking
            deactivate Booking

            Storage -> Bookings: add(booking)
            activate Bookings
            Bookings --> Storage
            deactivate Bookings
        end

        Storage --> User: booking list
    end

    deactivate Storage
end

note over User
    A command is processed and may
    change the current booking list.
end note

group Save current bookings
    User -> Storage: saveBookings(bookings)
    activate Storage

    loop for each booking
        Storage -> Bookings: get(index)
        activate Bookings
        Bookings --> Storage: booking
        deactivate Bookings

        Storage -> Booking: get booking details
        activate Booking
        Booking --> Storage: reason, name, venue,\ntiming and attendee count
        deactivate Booking

        note right of Storage
            Convert the booking
            into one line.
        end note
    end

    Storage -> Storage: write lines to bookings.txt
    Storage -> Storage: getLastModifiedTime()
    Storage --> User: last modified time
    deactivate Storage
end

@enduml
