@startuml
skinparam sequenceMessageAlign center
hide footbox

actor User
participant ":Ui" as UI
participant ":Parser" as Parser
participant ":BookingList" as Bookings

User -> UI: processCommand("book r/exam n/Midterm v/LT1 t/05/10/2026 14:00")
activate UI

UI -> Parser: parseCommand(userInput)
activate Parser
Parser --> UI: "book"
deactivate Parser

create participant ":BookCommand" as Book
UI -> Book: new BookCommand(parser)
activate Book
Book --> UI
deactivate Book

UI -> Book: execute(bookingList, userInput)
activate Book
Book -> Parser: parseBooking(userInput)
activate Parser

create participant "booking:Booking" as Booking
Parser -> Booking: new Booking(reason, name, venue, timing)
activate Booking
Booking --> Parser: booking
deactivate Booking
Parser --> Book: booking
deactivate Parser

Book -> Bookings: add(booking)
activate Bookings
Bookings --> Book
deactivate Bookings

Book -> Booking: toString()
activate Booking
Booking --> Book: booking text
deactivate Booking
Book --> User: "Booking added: " + booking text
Book --> UI
deactivate Book

deactivate UI
@enduml
