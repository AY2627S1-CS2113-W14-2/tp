@startuml
skinparam sequenceMessageAlign center
hide footbox

actor User

participant ":Ui" as UI

participant ":Parser" as Parser
participant "available:List<String>" as Available

User -> UI: processCommand("free t/28/10/2026 14:00")
activate UI

UI -> Parser: parseCommand(userInput)
activate Parser
Parser --> UI: "free"
deactivate Parser

create participant ":FreeCommand" as Free
UI -> Free: new FreeCommand(parser)

participant "VenueCatalog" as Catalog
participant ":BookingList" as Bookings

UI -> Free: execute(bookingList, userInput)
activate Free

Free -> Parser: parseFreeTime(userInput)
activate Parser
Parser --> Free: startTime
deactivate Parser

Free -> Catalog: findAvailableVenues(bookingList, startTime)
activate Catalog

loop For each preset venue
    Catalog -> Bookings: isVenueAvailable(venue, startTime)
    activate Bookings

    Bookings --> Catalog: available
    deactivate Bookings

    opt available
        Catalog -> Available: add(venue)
    end
end

Catalog --> Free: venues
deactivate Catalog

alt venues is empty
    Free --> User: no availability message
else venues is not empty
    loop For each available venue
        Free --> User: display number and venue
    end
end

Free --> UI
deactivate Free

deactivate UI
@enduml
