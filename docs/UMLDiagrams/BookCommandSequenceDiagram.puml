@startuml
skinparam sequenceMessageAlign center
hide footbox

actor User

participant ":Ui" as UI

participant ":Parser" as Parser
participant ":BookingList" as Bookings

User -> UI: processCommand("book r/exam n/CS2113 Midterm v/LT1 t/05/10/2026 14:00")
activate UI

UI -> Parser: parseCommand(userInput)
activate Parser
Parser --> UI: "book"
deactivate Parser

UI -> Parser: parseBooking(userInput)
activate Parser
create participant "booking:Booking" as Booking
Parser -> Booking: new Booking(reason, name, venue, timing)
Parser --> UI: booking
deactivate Parser

UI -> Bookings: findClash(booking)
activate Bookings
Bookings --> UI: clash
deactivate Bookings

alt clash != null
    UI --> User: Booking clash: venue is already booked
else no clash
    UI -> Bookings: add(booking)
    activate Bookings
    Bookings --> UI
    deactivate Bookings

    UI --> User: "Booking added: ..."
end

deactivate UI
@enduml