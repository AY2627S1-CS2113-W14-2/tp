@startuml
skinparam sequenceMessageAlign center
hide footbox

participant "EduReserve" as App

activate App
create participant ":Ui" as UI
App -> UI: new Ui(bookingList)

participant ":Parser" as Parser
participant ":BookingList" as Bookings

App -> UI: processCommand("book r/exam n/CS2113 Midterm v/LT1 t/05/10/2026 14:00")
activate UI

UI -> Parser: parseCommand(userInput)
activate Parser
Parser --> UI: "book"
deactivate Parser

UI -> Parser: parseBooking(userInput)
activate Parser
create participant "booking:Booking" as Booking
Parser -> Booking: new Booking(reason, name, venue, timing)
Parser --> UI: booking
deactivate Parser

UI -> Bookings: findClash(booking)
activate Bookings
Bookings --> UI: clash
deactivate Bookings

alt clash != null
    note right of UI
        Throw InvalidCommandException
        "Booking clash: venue is already booked"
    end note
else no clash
    UI -> Bookings: add(booking)
    activate Bookings
    Bookings --> UI
    deactivate Bookings

    note right of UI
        Print "Booking added: ..."
    end note
end

UI --> App: false
deactivate UI
deactivate App
@enduml