@startuml
skinparam sequenceMessageAlign center
hide footbox

actor User

participant ":Ui" as UI

participant ":Parser" as Parser
participant ":BookingList" as Bookings

User -> UI: processCommand("cancel n/CS2113 Midterm")
activate UI

UI -> Parser: parseCommand(userInput)
activate Parser
Parser --> UI: "cancel"
deactivate Parser

UI -> Parser: parseCancel(userInput)
activate Parser
Parser --> UI: "CS2113 Midterm"
deactivate Parser

UI -> Bookings: findByName("CS2113 Midterm")
activate Bookings
Bookings --> UI: index
deactivate Bookings

alt index == -1
    UI --> User: No booking found with the name
else booking found
    UI -> Bookings: get(index)
    activate Bookings
    Bookings --> UI: cancelled
    deactivate Bookings

    UI -> Bookings: remove(index)
    activate Bookings
    Bookings --> UI
    deactivate Bookings

    UI --> User: "Booking cancelled: ..."
end

deactivate UI
@enduml